# Production environment for the Spring Boot backend. Copy into your secret manager / deployment env.
# Generate each key with:  java -cp backend/target/classes com.newlife.hospital.security.EncryptionUtil keygen
DB_URL=jdbc:postgresql://localhost:5432/newlife_hospital
DB_USERNAME=newlife_app
DB_PASSWORD=change-me

# base64, 32+ random bytes: session token signing
APP_JWT_SECRET=
# base64, exactly 32 bytes: AES-256-GCM key for patient ID numbers. Back it up; the data is unreadable without it.
APP_CRYPTO_KEY=
# base64, 32+ bytes: blind index for duplicate ID detection. Must never change once patient data exists.
APP_HMAC_KEY=

# First administrator, created only when no admin exists. 10+ characters; change it after first sign-in.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=

# Keep true behind HTTPS
APP_COOKIE_SECURE=true
# Only needed if the SPA is served from a different origin than the API
APP_CORS_ORIGINS=
APP_UPLOAD_DIR=/var/lib/newlife/uploads
